+
+#if defined(__PROSPERO__) || defined(SH_PS5_PRESENT_DRAW)
+/* Digits and the letters of "FPS" as 5x7 bitmaps, one byte per row, bit 4 = leftmost. */
+static const unsigned char s_fpsGlyph[13][7] = {
+	{ 0x0E, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0E }, { 0x04, 0x0C, 0x04, 0x04, 0x04, 0x04, 0x0E },
+	{ 0x0E, 0x11, 0x01, 0x02, 0x04, 0x08, 0x1F }, { 0x1E, 0x01, 0x01, 0x0E, 0x01, 0x01, 0x1E },
+	{ 0x02, 0x06, 0x0A, 0x12, 0x1F, 0x02, 0x02 }, { 0x1F, 0x10, 0x1E, 0x01, 0x01, 0x11, 0x0E },
+	{ 0x06, 0x08, 0x10, 0x1E, 0x11, 0x11, 0x0E }, { 0x1F, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 },
+	{ 0x0E, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x0E }, { 0x0E, 0x11, 0x11, 0x0F, 0x01, 0x02, 0x0C },
+	{ 0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10 }, { 0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10 },
+	{ 0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E },
+};
+
+#define FPS_CHARS  7
+#define FPS_TEX_W  (FPS_CHARS * 6 + 3)
+#define FPS_TEX_H  11
+#define FPS_SCALE  4
+
+static void GR_Ps5FpsOverlay(void)
+{
+	static GLuint tex = 0;
+	static Uint32 lastTick = 0;
+	static int    frames = 0, fps = 0, dirty = 1;
+	const Uint32  now = SDL_GetTicks();
+
+	if (!g_cfg_showFps || g_presentWidth <= 0 || g_presentHeight <= 0)
+		return;
+
+	frames++;
+	if (lastTick == 0)
+		lastTick = now;
+	if (now - lastTick >= 500)
+	{
+		fps = (int)((float)frames * 1000.0f / (float)(now - lastTick) + 0.5f);
+		frames = 0;
+		lastTick = now;
+		dirty = 1;
+	}
+
+	if (tex == 0)
+	{
+		glad_glGenTextures(1, &tex);
+		dirty = 1;
+	}
+
+	if (dirty)
+	{
+		unsigned char pixels[FPS_TEX_W * FPS_TEX_H * 4];
+		char          text[FPS_CHARS + 1];
+		GLint         prevTex = 0, prevActive = 0;
+		int           i, x, y;
+
+		snprintf(text, sizeof(text), "%*d FPS", FPS_CHARS - 4, fps > 999 ? 999 : fps);
+		for (i = 0; i < FPS_TEX_W * FPS_TEX_H; i++)
+		{
+			pixels[i * 4 + 0] = 0;
+			pixels[i * 4 + 1] = 0;
+			pixels[i * 4 + 2] = 0;
+			pixels[i * 4 + 3] = 170;
+		}
+		for (i = 0; i < FPS_CHARS; i++)
+		{
+			const char c = text[i];
+			const int  g = (c >= '0' && c <= '9') ? c - '0' : (c == 'F') ? 10 : (c == 'P') ? 11 : (c == 'S') ? 12 : -1;
+
+			if (g < 0)
+				continue;
+			for (y = 0; y < 7; y++)
+			{
+				for (x = 0; x < 5; x++)
+				{
+					if (s_fpsGlyph[g][y] & (0x10 >> x))
+					{
+						/* Row 0 of the texture is the bottom of the box. */
+						const int px = 2 + i * 6 + x;
+						const int py = FPS_TEX_H - 1 - (2 + y);
+						unsigned char* p = &pixels[(py * FPS_TEX_W + px) * 4];
+
+						p[0] = 255; p[1] = 255; p[2] = 255; p[3] = 255;
+					}
+				}
+			}
+		}
+
+		glad_glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+		glad_glActiveTexture(GL_TEXTURE0);
+		glad_glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+		glad_glBindTexture(GL_TEXTURE_2D, tex);
+		glad_glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+		glad_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, FPS_TEX_W, FPS_TEX_H, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+		glad_glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+		glad_glActiveTexture((GLenum)prevActive);
+		dirty = 0;
+	}
+
+	Ps5DrawTexture(tex, g_presentWidth - FPS_TEX_W * FPS_SCALE - 16, g_presentHeight - FPS_TEX_H * FPS_SCALE - 16,
+	               FPS_TEX_W * FPS_SCALE, FPS_TEX_H * FPS_SCALE, 0, 0.0f, 0.0f, 1.0f, 1.0f, 1);
+
+	g_PreviousShader       = (ShaderID)-1;
+	g_lastBoundTexture     = (TextureID)-1;
+	g_PreviousBlendMode    = -999;
+	g_PreviousDepthMode    = -999;
+	g_PreviousScissorState = -999;
+}

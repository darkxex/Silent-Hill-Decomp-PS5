 		return;
@@ -1319,7 +1496,11 @@ static void GR_ResolveBackend(void)
 #if defined(RENDERER_OGL) || defined(RENDERER_OGLES)
 int GR_InitialiseGLContext(char* windowName, int fullscreen)
 {

diff --git a/src/render/PsyX_render.cpp b/src/render/PsyX_render.cpp
index d67eade..23c8aea 100644
--- a/src/render/PsyX_render.cpp
+++ b/src/render/PsyX_render.cpp
@@ -1017,9 +1017,186 @@ static void GR_PresentRect(int* outX, int* outY, int* outW, int* outH)
  * bilinear takes that crisp intermediate and eases only the leftover fraction,
  * so it fills the window without the mush of a plain linear stretch. Nearest
  * and bilinear stretch straight to the rect. */
+#if defined(__PROSPERO__) || defined(SH_PS5_PRESENT_DRAW)
+/* The PS5 GL driver resolves a scaling glBlitFramebuffer on the CPU (about 130 ms
+ * for the present blit); a textured triangle goes through its GPU draw path. */
+static GLuint s_ps5PresentProg = 0, s_ps5PresentVao = 0;
+static GLint  s_ps5PresentRectLoc = -1, s_ps5PresentAlphaLoc = -1;
+static int    s_ps5PresentFailed = 0;
+
+static int Ps5DrawTexture(GLuint tex, int dx, int dy, int dw, int dh, int linear, float u0, float v0, float u1, float v1, int overlay)
+{
+	GLint blendFunc[4] = { 0, 0, 0, 0 }, blendEq[2] = { 0, 0 };
+	GLint prevProg = 0, prevVao = 0, prevTex = 0, prevActive = 0, prevMin = 0, prevMag = 0, prevVp[4];
+	GLboolean prevMask[4];
+	GLboolean blend, depth, cull, stencil, scissor;
+
+	if (s_ps5PresentFailed || tex == 0 || dw <= 0 || dh <= 0)
+		return 0;
+
+	if (s_ps5PresentProg == 0)
+	{
+		static const char* vsSrc =
+			"#version 330 core\n"
+			"uniform vec4 uRect;\n"
+			"out vec2 uv;\n"
+			"void main(){ vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+			"uv = uRect.xy + p * (uRect.zw - uRect.xy); gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0); }\n";
+		static const char* fsSrc =
+			"#version 330 core\n"
+			"in vec2 uv; out vec4 color; uniform sampler2D tex; uniform float uAlpha;\n"
+			"void main(){ vec4 t = texture(tex, uv); color = vec4(t.rgb, mix(1.0, t.a, uAlpha)); }\n";
+		GLint ok = 0;
+		GLuint vs = glad_glCreateShader(GL_VERTEX_SHADER);
+		GLuint fs = glad_glCreateShader(GL_FRAGMENT_SHADER);
+
+		glad_glShaderSource(vs, 1, &vsSrc, NULL);
+		glad_glCompileShader(vs);
+		glad_glShaderSource(fs, 1, &fsSrc, NULL);
+		glad_glCompileShader(fs);
+		s_ps5PresentProg = glad_glCreateProgram();
+		glad_glAttachShader(s_ps5PresentProg, vs);
+		glad_glAttachShader(s_ps5PresentProg, fs);
+		glad_glLinkProgram(s_ps5PresentProg);
+		glad_glGetProgramiv(s_ps5PresentProg, GL_LINK_STATUS, &ok);
+		glad_glDeleteShader(vs);
+		glad_glDeleteShader(fs);
+		if (!ok)
+		{
+			s_ps5PresentFailed = 1;
+			return 0;
+		}
+		glad_glUseProgram(s_ps5PresentProg);
+		glad_glUniform1i(glad_glGetUniformLocation(s_ps5PresentProg, "tex"), 0);
+		s_ps5PresentRectLoc = glad_glGetUniformLocation(s_ps5PresentProg, "uRect");
+		s_ps5PresentAlphaLoc = glad_glGetUniformLocation(s_ps5PresentProg, "uAlpha");
+		glad_glGenVertexArrays(1, &s_ps5PresentVao);
+		glad_glUseProgram(0);
+	}
+
+	blend = glad_glIsEnabled(GL_BLEND);
+	depth = glad_glIsEnabled(GL_DEPTH_TEST);
+	cull = glad_glIsEnabled(GL_CULL_FACE);
+	stencil = glad_glIsEnabled(GL_STENCIL_TEST);
+	scissor = glad_glIsEnabled(GL_SCISSOR_TEST);
+	glad_glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+	glad_glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+	glad_glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+	glad_glActiveTexture(GL_TEXTURE0);
+	glad_glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+	glad_glGetIntegerv(GL_VIEWPORT, prevVp);
+	glad_glGetBooleanv(GL_COLOR_WRITEMASK, prevMask);
+
+	glad_glBindTexture(GL_TEXTURE_2D, tex);
+	glad_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &prevMin);
+	glad_glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, &prevMag);
+	glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+	glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, linear ? GL_LINEAR : GL_NEAREST);
+
+	if (overlay)
+	{
+		glad_glGetIntegerv(GL_BLEND_SRC_RGB, &blendFunc[0]);
+		glad_glGetIntegerv(GL_BLEND_DST_RGB, &blendFunc[1]);
+		glad_glGetIntegerv(GL_BLEND_SRC_ALPHA, &blendFunc[2]);
+		glad_glGetIntegerv(GL_BLEND_DST_ALPHA, &blendFunc[3]);
+		glad_glGetIntegerv(GL_BLEND_EQUATION_RGB, &blendEq[0]);
+		glad_glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &blendEq[1]);
+		glad_glEnable(GL_BLEND);
+		glad_glBlendEquation(GL_FUNC_ADD);
+		glad_glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+	}
+	else
+		glad_glDisable(GL_BLEND);
+	glad_glDisable(GL_DEPTH_TEST);
+	glad_glDisable(GL_CULL_FACE);
+	glad_glDisable(GL_STENCIL_TEST);
+	glad_glDisable(GL_SCISSOR_TEST);
+	glad_glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	glad_glViewport(dx, dy, dw, dh);
+	glad_glUseProgram(s_ps5PresentProg);
+	glad_glUniform4f(s_ps5PresentRectLoc, u0, v0, u1, v1);
+	glad_glUniform1f(s_ps5PresentAlphaLoc, overlay ? 1.0f : 0.0f);
+	glad_glBindVertexArray(s_ps5PresentVao);
+	glad_glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, prevMin);
+	glad_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, prevMag);
+	glad_glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+	glad_glActiveTexture((GLenum)prevActive);
+	glad_glBindVertexArray((GLuint)prevVao);
+	glad_glUseProgram((GLuint)prevProg);
+	glad_glViewport(prevVp[0], prevVp[1], prevVp[2], prevVp[3]);
+	glad_glColorMask(prevMask[0], prevMask[1], prevMask[2], prevMask[3]);
+	if (overlay)
+	{
+		glad_glBlendEquationSeparate((GLenum)blendEq[0], (GLenum)blendEq[1]);
+		glad_glBlendFuncSeparate((GLenum)blendFunc[0], (GLenum)blendFunc[1], (GLenum)blendFunc[2], (GLenum)blendFunc[3]);
+	}
+	if (blend) glad_glEnable(GL_BLEND);
+	else glad_glDisable(GL_BLEND);
+	if (depth) glad_glEnable(GL_DEPTH_TEST);
+	if (cull) glad_glEnable(GL_CULL_FACE);
+	if (stencil) glad_glEnable(GL_STENCIL_TEST);
+	if (scissor) glad_glEnable(GL_SCISSOR_TEST);
+	return 1;
+}
+
+static int GR_Ps5PresentDraw(int dx, int dy, int dw, int dh, int linear)
+{
+	if (s_internalColorTex == 0)
+		return 0;
+	return Ps5DrawTexture(s_internalColorTex, dx, dy, dw, dh, linear, 0.0f, 0.0f, 1.0f, 1.0f, 0);
+}
+
+/* A colour blit that scales or flips is done as a draw, from the texture behind the
+ * read framebuffer; the driver runs those blits through a slower special path. */
+static int Ps5BlitAsDraw(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1, unsigned mask, unsigned filter)
+{
+	GLint type = 0, name = 0, w = 0, h = 0, prevTex = 0;
+	int sw = sx1 - sx0, sh = sy1 - sy0, dw = dx1 - dx0, dh = dy1 - dy0;
+	float u0, v0, u1, v1;
+	int ndx = dx0, ndy = dy0;
+
+	if (mask != GL_COLOR_BUFFER_BIT || (sw == dw && sh == dh))
+		return 0;
+	glad_glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+	if (type != GL_TEXTURE)
+		return 0;
+	glad_glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+	if (name == 0)
+		return 0;
+	glad_glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+	glad_glBindTexture(GL_TEXTURE_2D, (GLuint)name);
+	glad_glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+	glad_glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+	glad_glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+	if (w <= 0 || h <= 0)
+		return 0;
+
+	u0 = (float)sx0 / (float)w; u1 = (float)sx1 / (float)w;
+	v0 = (float)sy0 / (float)h; v1 = (float)sy1 / (float)h;
+	if (dw < 0) { float t = u0; u0 = u1; u1 = t; ndx = dx1; dw = -dw; }
+	if (dh < 0) { float t = v0; v0 = v1; v1 = t; ndy = dy1; dh = -dh; }
+	return Ps5DrawTexture((GLuint)name, ndx, ndy, dw, dh, filter == GL_LINEAR, u0, v0, u1, v1, 0);
+}
+
+static void Ps5Blit(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1, unsigned mask, unsigned filter)
+{
+	if (Ps5BlitAsDraw(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, mask, filter))
+		return;
+	glad_glBlitFramebuffer(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, mask, filter);
+}
+#define glBlitFramebuffer(...) Ps5Blit(__VA_ARGS__)
+#endif
+
 static void GR_PresentBlit(GLuint src, int dx, int dy, int dw, int dh)
 {
 	const int mode = g_PcPresentScale;

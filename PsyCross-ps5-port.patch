+static int GR_Ps5PresentDraw(int dx, int dy, int dw, int dh, int linear)
+{
+	if (s_internalColorTex == 0)
+		return 0;
+	return Ps5DrawTexture(s_internalColorTex, dx, dy, dw, dh, linear, 0.0f, 0.0f, 1.0f, 1.0f, 0);
+}
+
+/* A colour blit that scales or flips is done as a draw, from the texture behind the
+ * read framebuffer; the driver runs those blits through a slower special path. */
+static int Ps5BlitAsDraw(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1, unsigned mask, unsigned filter)
+{
+	GLint type = 0, name = 0, w = 0, h = 0, prevTex = 0;
+	int sw = sx1 - sx0, sh = sy1 - sy0, dw = dx1 - dx0, dh = dy1 - dy0;
+	float u0, v0, u1, v1;
+	int ndx = dx0, ndy = dy0;
+
+	if (mask != GL_COLOR_BUFFER_BIT || (sw == dw && sh == dh))
+		return 0;
+	glad_glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+	if (type != GL_TEXTURE)
+		return 0;
+	glad_glGetFramebufferAttachmentParameteriv(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+	if (name == 0)
+		return 0;
+	glad_glGetIntegerv(GL_TEXTURE_BINDING_2D, &prevTex);
+	glad_glBindTexture(GL_TEXTURE_2D, (GLuint)name);
+	glad_glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+	glad_glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+	glad_glBindTexture(GL_TEXTURE_2D, (GLuint)prevTex);
+	if (w <= 0 || h <= 0)
+		return 0;
+
+	u0 = (float)sx0 / (float)w; u1 = (float)sx1 / (float)w;
+	v0 = (float)sy0 / (float)h; v1 = (float)sy1 / (float)h;
+	if (dw < 0) { float t = u0; u0 = u1; u1 = t; ndx = dx1; dw = -dw; }
+	if (dh < 0) { float t = v0; v0 = v1; v1 = t; ndy = dy1; dh = -dh; }
+	return Ps5DrawTexture((GLuint)name, ndx, ndy, dw, dh, filter == GL_LINEAR, u0, v0, u1, v1, 0);
+}
+
+static void Ps5Blit(int sx0, int sy0, int sx1, int sy1, int dx0, int dy0, int dx1, int dy1, unsigned mask, unsigned filter)
+{
+	if (Ps5BlitAsDraw(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, mask, filter))
+		return;
+	glad_glBlitFramebuffer(sx0, sy0, sx1, sy1, dx0, dy0, dx1, dy1, mask, filter);
+}
+#define glBlitFramebuffer(...) Ps5Blit(__VA_ARGS__)

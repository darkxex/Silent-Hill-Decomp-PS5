+		return;
+
+	frames++;
+	if (lastTick == 0)
+		lastTick = now;
+	if (now - lastTick >= 500)
+	{
+		fps = (int)((float)frames * 1000.0f / (float)(now - lastTick) + 0.5f);
+		frames = 0;
+		lastTick = now;
+		dirty = 1;
+	}

+static void GR_Ps5FpsOverlay(void)
+{
+	static GLuint tex = 0;
+	static Uint32 lastTick = 0;
+	static int    frames = 0, fps = 0, dirty = 1;
+	const Uint32  now = SDL_GetTicks();

+			"void main(){ vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+			"gl_Position = vec4(p * 2.0 - 1.0, 1.0, 1.0); }\n";
+		static const char* fsSrc =
+			"#version 330 core\n"
+			"uniform vec4 uColor; out vec4 color; void main(){ color = uColor; }\n";
+		GLint ok = 0;
+		GLuint vs = glad_glCreateShader(GL_VERTEX_SHADER);
+		GLuint fs = glad_glCreateShader(GL_FRAGMENT_SHADER);

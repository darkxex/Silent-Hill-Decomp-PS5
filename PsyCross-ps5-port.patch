+	stencil = glad_glIsEnabled(GL_STENCIL_TEST);
+	cull = glad_glIsEnabled(GL_CULL_FACE);
+	blend = glad_glIsEnabled(GL_BLEND);
+	polyOfs = glad_glIsEnabled(GL_POLYGON_OFFSET_FILL);
+	glad_glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+	glad_glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+	glad_glGetBooleanv(GL_COLOR_WRITEMASK, prevColor);
+	glad_glGetBooleanv(GL_DEPTH_WRITEMASK, &prevDepthMask);
+	glad_glGetIntegerv(GL_DEPTH_FUNC, &prevDepthFunc);
+	glad_glGetIntegerv(GL_STENCIL_FUNC, &prevStFunc);
+	glad_glGetIntegerv(GL_STENCIL_REF, &prevRef);
+	glad_glGetIntegerv(GL_STENCIL_VALUE_MASK, &prevVMask);
+	glad_glGetIntegerv(GL_STENCIL_WRITEMASK, &prevWMask);
+	glad_glGetIntegerv(GL_STENCIL_FAIL, &prevFail);
+	glad_glGetIntegerv(GL_STENCIL_PASS_DEPTH_FAIL, &prevZFail);
+	glad_glGetIntegerv(GL_STENCIL_PASS_DEPTH_PASS, &prevZPass);
+	glad_glGetDoublev(GL_DEPTH_RANGE, prevRange);
+	glad_glGetIntegerv(GL_VIEWPORT, prevVp);
+	(void)prevFunc;
+	(void)prevPoly;
+
+	glad_glUseProgram(s_ps5ClearProg);
+	glad_glBindVertexArray(s_ps5ClearVao);
+	/* glClear ignores the viewport; the triangle must cover the whole target. */
+	glad_glViewport(0, 0, 8192, 8192);
+	if (colorMode)
+		glad_glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+	else
+		glad_glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+	glad_glUniform4f(s_ps5ClearColorLoc, cr, cg, cb, 1.0f);
+	glad_glDisable(GL_BLEND);
+	glad_glDisable(GL_CULL_FACE);
+	glad_glDisable(GL_POLYGON_OFFSET_FILL);
+	glad_glEnable(GL_DEPTH_TEST);
+	glad_glDepthFunc(GL_ALWAYS);
+	glad_glDepthMask(GL_TRUE);
+	glad_glDepthRange(0.0, 1.0);
+	if (colorMode)
+	{
+		glad_glDisable(GL_STENCIL_TEST);
+	}
+	else
+	{
+		glad_glEnable(GL_STENCIL_TEST);
+		glad_glStencilFunc(GL_ALWAYS, 0, 0xFF);
+		glad_glStencilOp(GL_REPLACE, GL_REPLACE, GL_REPLACE);
+		glad_glStencilMask(0xFF);
+	}
+	glad_glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	glad_glViewport(prevVp[0], prevVp[1], prevVp[2], prevVp[3]);
+	glad_glDepthRange(prevRange[0], prevRange[1]);
+	glad_glStencilMask((GLuint)prevWMask);
+	glad_glStencilOp((GLenum)prevFail, (GLenum)prevZFail, (GLenum)prevZPass);
+	glad_glStencilFunc((GLenum)prevStFunc, prevRef, (GLuint)prevVMask);
+	if (stencil) glad_glEnable(GL_STENCIL_TEST);
+	else glad_glDisable(GL_STENCIL_TEST);
+	glad_glDepthMask(prevDepthMask);
+	glad_glDepthFunc((GLenum)prevDepthFunc);
+	if (!depth) glad_glDisable(GL_DEPTH_TEST);
+	if (polyOfs) glad_glEnable(GL_POLYGON_OFFSET_FILL);
+	if (cull) glad_glEnable(GL_CULL_FACE);
+	if (blend) glad_glEnable(GL_BLEND);
+	glad_glColorMask(prevColor[0], prevColor[1], prevColor[2], prevColor[3]);
+	glad_glBindVertexArray((GLuint)prevVao);
+	glad_glUseProgram((GLuint)prevProg);
+
+	g_PreviousShader       = (ShaderID)-1;
+	g_PreviousBlendMode    = -999;
+	g_PreviousDepthMode    = -999;
+	g_PreviousScissorState = -999;
+	return 1;
+}

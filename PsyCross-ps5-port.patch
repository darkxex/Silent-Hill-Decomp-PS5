+		glad_glShaderSource(vs, 1, &vsSrc, NULL);
+		glad_glCompileShader(vs);
+		glad_glShaderSource(fs, 1, &fsSrc, NULL);
+		glad_glCompileShader(fs);
+		s_ps5ClearProg = glad_glCreateProgram();
+		glad_glAttachShader(s_ps5ClearProg, vs);
+		glad_glAttachShader(s_ps5ClearProg, fs);
+		glad_glLinkProgram(s_ps5ClearProg);
+		glad_glGetProgramiv(s_ps5ClearProg, GL_LINK_STATUS, &ok);
+		glad_glDeleteShader(vs);
+		glad_glDeleteShader(fs);

set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PS5_ROOT "$ENV{PS5_ROOT}")
set(CMAKE_C_COMPILER   "${PS5_ROOT}/ps5-native-app-boilerplate/tooling/prospero-clang18")
set(CMAKE_CXX_COMPILER "${PS5_ROOT}/ps5-native-app-boilerplate/tooling/prospero-clang18")
set(CMAKE_C_FLAGS_INIT "-I${CMAKE_CURRENT_LIST_DIR}/shim -D__PROSPERO__ -DSH_PS5 -fPIC -Wno-implicit-function-declaration -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types -Wno-return-type")
set(CMAKE_CXX_FLAGS_INIT "-I${CMAKE_CURRENT_LIST_DIR}/shim -D__PROSPERO__ -DSH_PS5 -fPIC -Wno-implicit-function-declaration -Wno-int-conversion -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types -Wno-return-type")
set(CMAKE_PREFIX_PATH "${PS5_ROOT}/ps5-opengl/build/native-build/sdk;${PS5_ROOT}/ps5-opengl-sdk-dl/ps5-opengl-sdk-1.0.2/sdk")
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(SH_PS5 TRUE)
